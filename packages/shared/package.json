{
  "name": "@color-app/shared",
  "version": "1.0.0",
  "description": "Shared Zod schemas, TypeScript types, and API client for the color picker app",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "generate:client": "node scripts/generate-api.js"
  },
  "devDependencies": {
    "openapi-typescript": "^7.8.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "zod": "^4.0.0"
  }
}
