{
  "$schema": "https://schema.stryker-mutator.io/stryker-config.schema.json",
  "mutate": ["src/App.tsx", "src/ColorPicker.tsx:1-97", "src/ColorPicker.tsx:183-379", "src/ConfirmDialog.tsx"],
  "ignorePatterns": [
    "mobile",
    "server",
    "e2e",
    "performance",
    "packages",
    ".nyc_output",
    "reports",
    "coverage",
    "build"
  ],
  "ignoreStatic": true,
  "testRunner": "jest",
  "jest": {
    "projectType": "create-react-app"
  },
  "coverageAnalysis": "perTest",
  "reporters": ["progress", "clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/frontend/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "incremental": true,
  "incrementalFile": "reports/mutation/frontend/.stryker-incremental.json"
}
